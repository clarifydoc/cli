# The tree-sitter grammar packages declare conflicting peerOptional ranges on
# `tree-sitter` (some want ^0.22.x, others ^0.25.x), so npm can't resolve a
# single version and fails with ERESOLVE. This project parses via
# web-tree-sitter (WASM), not the native tree-sitter binding, so the peer
# version is irrelevant — relax the strict peer check instead of failing.
legacy-peer-deps=true

# Most tree-sitter grammar packages declare `install: node-gyp rebuild` to compile
# a NATIVE binding. This project never loads those — it parses through
# web-tree-sitter (WASM) — so the C++ toolchain is pure cost, and on Windows
# node-gyp fails outright on Visual Studio 18 ("unknown version undefined").
# Skip install scripts; `npm run setup` then builds the two grammars whose wasm
# npm doesn't ship, and fetches the tree-sitter CLI binary this flag would skip.
ignore-scripts=true
