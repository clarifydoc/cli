{
  "name": "clarifydoc",
  "version": "0.5.0",
  "description": "Extract structured information from any codebase — routes, endpoints, data flow, components",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "clarifydoc": "dist/cli.js"
  },
  "scripts": {
    "setup": "node scripts/setup-grammars.mjs",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "code-analysis",
    "ast",
    "tree-sitter",
    "reverse-engineering",
    "documentation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@davisvaughan/tree-sitter-r": "^1.3.0",
    "@tree-sitter-grammars/tree-sitter-zig": "^1.1.2",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-fsharp": "^0.3.12",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-julia": "^0.23.1",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-ocaml": "^0.24.2",
    "tree-sitter-pascal": "^0.0.1",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-vue": "^0.2.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tree-sitter-cli": "^0.27.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "nan": "^2.27.0"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clarifydoc/cli.git"
  },
  "bugs": {
    "url": "https://github.com/clarifydoc/cli/issues"
  },
  "homepage": "https://github.com/clarifydoc/cli#readme"
}
